diff --git a/tools/server/CMakeLists.txt b/tools/server/CMakeLists.txt
index 02607c8..efc63f4 100644
--- a/tools/server/CMakeLists.txt
+++ b/tools/server/CMakeLists.txt
@@ -41,6 +41,21 @@ target_include_directories(${TARGET} PRIVATE ../mtmd)
 target_include_directories(${TARGET} PRIVATE ${CMAKE_SOURCE_DIR})
 target_link_libraries(${TARGET} PUBLIC llama-common mtmd ${CMAKE_THREAD_LIBS_INIT})
 
+# CompilerGPT: the handshake, compiled in. A Rust static library exposing four C
+# functions (see handshake.h). Point HANDSHAKE_LIB at the built .lib; when unset the
+# server builds stock and --handshake-vetted is simply absent from the seeded slots.
+if (DEFINED HANDSHAKE_LIB AND EXISTS "${HANDSHAKE_LIB}")
+    target_link_libraries(${TARGET} PUBLIC "${HANDSHAKE_LIB}")
+    if (WIN32)
+        # Rust's std pulls these in; MSVC will not find them on its own.
+        target_link_libraries(${TARGET} PUBLIC ws2_32 userenv bcrypt ntdll advapi32)
+    endif()
+    target_compile_definitions(${TARGET} PRIVATE COMPILERGPT_HANDSHAKE=1)
+    message(STATUS "CompilerGPT handshake linked: ${HANDSHAKE_LIB}")
+else()
+    message(WARNING "CompilerGPT: HANDSHAKE_LIB not set or not found - server builds without the handshake")
+endif()
+
 if (LLAMA_SERVER_PCH)
     target_precompile_headers(${TARGET} PRIVATE ${CMAKE_SOURCE_DIR}/common/common.h)
 endif()
