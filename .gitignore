# The organ: a llama.cpp clone with its CUDA build tree. Gigabytes, and its own git.
organ/llama-src/

# Build output. The paths moved under testing/ on 23 Sep when everything that is not
# the product was stripped out of the root - the ignores have to move with them, or a
# virtualenv walks into the history. It nearly did.
testing/agent/**/bin/
testing/agent/**/obj/
rust/target/
testing/python/.venv/
testing/**/__pycache__/
testing/python/*.egg-info/
testing/python/build/
testing/**/node_modules/
book/shopfloor/bin/
book/shopfloor/obj/
book/shopfloor/*.db

# Run logs and experiment output are evidence, kept locally, not history
runs/

# Saved model state and vectors: binary, big, rebuildable
harness/*.kv
harness/cache/
*.gguf
*.vec

# The shopfloor sample is a git repo of its own and 36MB of bins - not part of Sarge
book/shopfloor/

# Secrets never
*.env
appsettings.*.json

# generated by install.ps1, with the running machine's own paths in them
start-organ.cmd
start-console.cmd
models/

# The Windows organ build tree: llama-server.exe, the CUDA DLLs, 46MB. Caught 21 Sep
# when git add -A staged the lot into the release repo.
organ/build/
hooks/__pycache__/
